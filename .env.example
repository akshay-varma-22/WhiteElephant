# =====================================================================
# White Elephant Creative Studio — environment variables (EXAMPLE)
#
#  * Copy to `.env` for local development:   cp .env.example .env
#  * In production, set these in Netlify:    Project configuration > Environment variables
#  * `.env` is git-ignored. NEVER commit real values. This file holds placeholders only.
#  * Variables WITHOUT a VITE_ prefix are server-side only and are never sent to the browser.
# =====================================================================

# ---- Who receives leads ----------------------------------------------
# Inbox(es) that receive every quotation lead. Several addresses may be separated by commas.
# Defaults to the studio's business email. Change it (and redeploy) to send leads somewhere else.
LEAD_TO_EMAIL=whiteelephantcreativestudio@gmail.com

# ---- How email is sent: choose ONE of the two options below -----------
# MAIL_PROVIDER picks the option. If you leave it empty, Gmail is used when GMAIL_APP_PASSWORD is
# set, otherwise Resend.
MAIL_PROVIDER=gmail

# ---------- OPTION 1: Gmail SMTP with an App Password (no extra service) ----------
# 1. Turn on 2-Step Verification for the Google account that will SEND the emails.
# 2. Create an App Password: https://myaccount.google.com/apppasswords   (16 letters, shown as 4 groups)
# 3. Put the account's address and the app password here. Spaces in the password are fine.
# SECURITY: an app password gives full access to that Gmail account's mail, not just sending.
# Strongly recommended: use a dedicated "website sender" Gmail account, not the main business inbox.
# Gmail always sends "From" this account. Limit: about 500 messages per day for a regular account.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# ---------- OPTION 2: Resend (separate email service) ----------
# API key from https://resend.com/api-keys (permission: Sending access).
RESEND_API_KEY=
# Sender shown on the email. Until you verify your domain in Resend, use Resend's shared test sender,
# which can only deliver to the address that owns your Resend account. After verifying the domain, e.g.:
#   White Elephant Website <leads@whiteelephantcreativestudio.com>
MAIL_FROM=White Elephant Website <onboarding@resend.dev>

# ---- Optional ---------------------------------------------------------
# Also email the visitor a short acknowledgement (only if they typed an email address).
# With Gmail it is sent from the same Gmail account; with Resend it needs a verified sending domain.
SEND_CUSTOMER_CONFIRMATION=false

# Cloudflare Turnstile CAPTCHA (free). The secret is server-side; the site key is public.
# Leave both empty to run without a CAPTCHA (honeypot + rate limiting still apply).
TURNSTILE_SECRET_KEY=
VITE_TURNSTILE_SITE_KEY=

# Extra origins allowed to POST to the form endpoint (comma-separated). Usually empty.
ALLOWED_ORIGINS=

# Best-effort per-IP limit applied inside the function (Netlify also enforces its own limit).
RATE_LIMIT_MAX=6
RATE_LIMIT_WINDOW_SECONDS=600

# ---- Testing only (leave empty in production) ------------------------
# Point the function at local test servers instead of the real services (see `npm run dev:mock`).
RESEND_API_URL=
TURNSTILE_VERIFY_URL=
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
